generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model app_user {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email              String               @unique @db.VarChar(255)
  password_hash      String?
  nom                String?              @db.VarChar(100)
  prenom             String?              @db.VarChar(100)
  langue             String?              @default("fr") @db.VarChar(10)
  created_at         DateTime?            @default(now()) @db.Timestamp(6)
  updated_at         DateTime?            @default(now()) @db.Timestamp(6)
  athlete            athlete?
  metric_measurement metric_measurement[]
  coach_profile      coach_profile?
  wt_links_decided   athlete_wt_link[]    @relation("wt_link_decider")
  club_scales_edited club_metric_scale[]  @relation("club_scale_editor")

  // Ticket "Notifications in-app Coach + Athlete V1" : une notification
  // appartient toujours à app_user (jamais directement athlete_id/coach_id),
  // voir modèle notification ci-dessous pour la justification complète.
  notifications_received notification[] @relation("notification_recipient")
  notifications_sent     notification[] @relation("notification_actor")
}

model athlete {
  id                            String                          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                       String                          @unique @db.Uuid
  club_id                       String?                         @db.Uuid
  categorie_age                 String?                         @db.VarChar(50)
  genre                         String?                         @db.VarChar(30)
  grade                         String?                         @db.VarChar(100)
  date_naissance                DateTime?                       @db.Date
  niveau_sportif                String?                         @db.VarChar(50)
  // État de forme déclaré par l'athlète lui-même (PUT /athletes/:id/condition),
  // visible par ses coachs. Convention varchar contrôlée en application
  // (ATHLETE_CONDITIONS), jamais un enum Prisma : "actif" | "malade" |
  // "blesse" | "absent". Seul l'état ACTUEL est conservé (pas d'historique
  // en V1). note/retour toujours NULL quand l'état est "actif".
  etat_forme                    String                          @default("actif") @db.VarChar(20)
  etat_forme_note               String?                         @db.VarChar(255)
  etat_forme_retour             DateTime?                       @db.Date
  etat_forme_updated_at         DateTime?                       @db.Timestamp(6)
  created_at                    DateTime?                       @default(now()) @db.Timestamp(6)
  updated_at                    DateTime?                       @default(now()) @db.Timestamp(6)
  club                          club?                           @relation(fields: [club_id], references: [id], onUpdate: NoAction)
  app_user                      app_user                        @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  athlete_goal                  athlete_goal[]
  metric_measurement            metric_measurement[]
  participation                 participation[]
  training_session              training_session[]
  weight_log                    weight_log[]
  weight_target                 weight_target[]
  coach_athlete                 coach_athlete[]
  coach_group_athlete           coach_group_athlete[]
  coach_training_assignment     coach_training_assignment[]
  coach_exercise_assignment     coach_exercise_assignment[]
  coach_competition_preparation coach_competition_preparation[]
  training_attendance           training_attendance[]
  wt_link                       athlete_wt_link?
}

model athlete_goal {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  athlete_id  String      @db.Uuid
  type        String?     @db.VarChar(50)
  titre       String      @db.VarChar(255)
  description String?
  date_cible  DateTime?   @db.Date
  statut      String?     @default("en_cours") @db.VarChar(30)
  created_at  DateTime?   @default(now()) @db.Timestamp(6)
  updated_at  DateTime?   @default(now()) @db.Timestamp(6)
  athlete     athlete     @relation(fields: [athlete_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  goal_step   goal_step[]

  @@index([athlete_id], map: "idx_goal_athlete")
}

model club {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nom              String             @db.VarChar(255)
  pays             String?            @db.VarChar(100)
  ville            String?            @db.VarChar(100)
  created_at       DateTime?          @default(now()) @db.Timestamp(6)
  updated_at       DateTime?          @default(now()) @db.Timestamp(6)
  athlete          athlete[]
  coach_profile    coach_profile[]
  club_invitation  club_invitation[]
  metric_scales    club_metric_scale[]
}

model competition {
  id                            String                          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nom                           String                          @db.VarChar(255)
  organisateur                  String?                         @db.VarChar(255)
  date_debut                    DateTime                        @db.Date
  date_fin                      DateTime?                       @db.Date
  lieu                          String?                         @db.VarChar(255)
  ville                         String?                         @db.VarChar(100)
  pays                          String?                         @db.VarChar(100)
  niveau                        String?                         @db.VarChar(50)
  saison                        String?                         @db.VarChar(20)
  created_at                    DateTime?                       @default(now()) @db.Timestamp(6)
  updated_at                    DateTime?                       @default(now()) @db.Timestamp(6)
  participation                 participation[]
  weight_target                 weight_target[]
  sources                       competition_source[]
  entries                       competition_entry[]
  matches                       competition_match[]
  coach_competition_preparation coach_competition_preparation[]
  wt_backfill_events            wt_backfill_event[]
}

// Références externes d'une competition canonique EKVARA : une même
// compétition réelle peut être connue de plusieurs sources d'import (FFTDA,
// Martial Events, World Taekwondo...). L'identité canonique utilisée par
// tout le reste d'EKVARA (participation, weight_target) reste exclusivement
// competition.id — jamais source/source_external_id.
model competition_source {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  competition_id String      @db.Uuid
  competition    competition @relation(fields: [competition_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  source             String  @db.VarChar(50)
  source_external_id String  @db.VarChar(255)
  source_url         String? @db.VarChar(500)

  // Valeurs brutes telles que fournies par CETTE source, même si elles
  // diffèrent de la valeur canonique retenue sur competition (voir politique
  // de fusion "combler les champs null uniquement" dans CompetitionsRepository).
  raw_nom          String? @db.VarChar(255)
  raw_organisateur String? @db.VarChar(255)
  raw_lieu         String? @db.VarChar(255)
  raw_ville        String? @db.VarChar(100)
  raw_pays         String? @db.VarChar(100)
  raw_niveau       String? @db.VarChar(50)
  // Lignes Date/Discipline publiées par le calendrier WT pour CETTE entrée
  // (#22), texte brut + dates dérivées : [{dateText, discipline, start, end}].
  // NULL = jamais capturé (autres sources, ou entrée WT pas encore ré-importée).
  raw_divisions    Json?

  // "safe" : rattachée automatiquement par matchCompetitions() ; "manual" :
  // rattachement humain futur ; null : source primaire d'une competition
  // jamais rapprochée d'une autre (cas normal de la grande majorité des lignes).
  match_confidence String? @db.VarChar(20)

  created_at DateTime? @default(now()) @db.Timestamp(6)
  updated_at DateTime? @default(now()) @db.Timestamp(6)

  @@unique([source, source_external_id])
  @@index([competition_id])
}

// Inscrit externe d'une compétition, tel que fourni par une source (pour
// l'instant uniquement Martial Events, via /events/:slug/entries) — donnée
// PUREMENT informative de compétition, jamais liée à un athlete EKVARA (voir
// ticket "Persistance des inscrits Martial Events"). Rattachée exclusivement
// à competition.id canonique, jamais à un id source.
//
// LIMITE CONNUE (documentée, acceptée pour le MVP) : Martial Events ne fournit
// aucun participant_id stable (voir me-normalizer.ts) — la clé d'unicité
// repose donc sur (competition_id, source, participant_name,
// source_category_raw_label). Deux homonymes exacts inscrits dans la même
// catégorie de la même compétition entreraient en collision et seraient
// confondus en une seule ligne. Aucune tentative de contournement (club dans
// la clé, numéro de ligne, nom normalisé agressivement) sans preuve de
// stabilité de ces signaux côté source.
model competition_entry {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  competition_id String      @db.Uuid
  competition    competition @relation(fields: [competition_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  source                    String @db.VarChar(50)
  source_category_raw_label String @db.VarChar(255)

  age_category    String? @db.VarChar(50)
  gender          String? @db.VarChar(20)
  weight_category String? @db.VarChar(50)

  participant_name String  @db.VarChar(255)
  club             String? @db.VarChar(255)
  league           String? @db.VarChar(255)
  country          String? @db.VarChar(100)

  created_at DateTime? @default(now()) @db.Timestamp(6)
  updated_at DateTime? @default(now()) @db.Timestamp(6)

  @@unique([competition_id, source, participant_name, source_category_raw_label])
  @@index([competition_id])
  @@index([competition_id, weight_category])
}

// Athlète PUBLIC/international, tel que connu d'une source externe (pour
// l'instant World Taekwondo Results — ticket "WT Results Data Foundation V1").
// Volontairement SANS aucun lien vers `athlete` (compte EKVARA, 1:1 avec
// app_user) : un athlète présent dans une source publique n'est jamais
// automatiquement un utilisateur EKVARA, et aucun rapprochement par nom/pays/
// club n'est fait ici. L'identité vient exclusivement de
// external_athlete_source (une ligne par source, clé unique
// [source, source_external_id]) pour pouvoir rattacher plus tard d'autres
// sources (rankings GMS...) sans reconstruire l'identité.
//
// gender / birth_date : nullables, restent NULL tant qu'une source ne les
// expose pas réellement (WT Results ne les expose pas — jamais inférés depuis
// une catégorie de poids).
model external_athlete {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  display_name String    @db.VarChar(255)
  // Code NOC 3 lettres tel que fourni par la source (FRA, KOR, AIN...), jamais
  // converti vers les libellés texte de competition_entry.country.
  country_code String?   @db.VarChar(10)
  gender       String?   @db.VarChar(20)
  birth_date   DateTime? @db.Date
  created_at   DateTime? @default(now()) @db.Timestamp(6)
  updated_at   DateTime? @default(now()) @db.Timestamp(6)

  sources      external_athlete_source[]
  matches_as_a competition_match[]       @relation("match_athlete_a")
  matches_as_b competition_match[]       @relation("match_athlete_b")
  matches_won  competition_match[]       @relation("match_winner")
  athlete_links athlete_wt_link[]
}

// Lien entre un compte EKVARA (athlete) et SON profil public World Taekwondo
// (external_athlete). Jamais créé automatiquement : l'athlète le réclame
// (status "pending"), son coach le confirme ("confirmed") ou le refuse (la
// ligne est alors supprimée) — un profil public ne devient jamais celui d'un
// utilisateur sur la seule foi d'un nom (homonymes, aucune date de naissance
// chez WT). Un athlète a au plus UN lien (athlete_id unique) ; un même
// profil WT n'est confirmé que pour un seul compte (vérifié en service, dans
// la transaction de confirmation). status : convention varchar contrôlée en
// application ("pending" | "confirmed"), jamais un enum Prisma.
model athlete_wt_link {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  athlete_id          String           @unique @db.Uuid
  external_athlete_id String           @db.Uuid
  status              String           @db.VarChar(20)
  requested_at        DateTime         @default(now()) @db.Timestamp(6)
  decided_at          DateTime?        @db.Timestamp(6)
  decided_by_user_id  String?          @db.Uuid
  athlete             athlete          @relation(fields: [athlete_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  external_athlete    external_athlete @relation(fields: [external_athlete_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  decided_by          app_user?        @relation("wt_link_decider", fields: [decided_by_user_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([external_athlete_id])
}

// Provenance + identité d'un external_athlete pour UNE source. Pour WT
// Results : source = "world_taekwondo_results", source_external_id = UUID du
// profil WT Results. record_* = record V/D AFFICHÉ par la source à
// record_synced_at (snapshot avec provenance, jamais recalculé : notre jeu de
// matchs est partiel, un record dérivé serait faux).
model external_athlete_source {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  external_athlete_id String           @db.Uuid
  external_athlete    external_athlete @relation(fields: [external_athlete_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  source             String  @db.VarChar(50)
  source_external_id String  @db.VarChar(255)
  source_url         String? @db.VarChar(500)

  raw_name  String? @db.VarChar(255)
  // URL publique de la photo chez la source : jamais téléchargée/réhébergée.
  image_url String? @db.VarChar(500)

  record_wins      Int?
  record_losses    Int?
  record_synced_at DateTime? @db.Timestamp(6)

  created_at DateTime? @default(now()) @db.Timestamp(6)
  updated_at DateTime? @default(now()) @db.Timestamp(6)

  @@unique([source, source_external_id])
  @@index([external_athlete_id])
}

// Combat entre deux external_athlete lors d'une compétition CANONIQUE EKVARA
// (jamais un id de source, comme competition_entry/competition_source).
// Identité logique = [source, source_external_id] (id du match chez la
// source), jamais noms + date.
//
// Orientation : athlete_a / athlete_b et score_a / score_b suivent l'ordre
// EXPLICITE de la page match de la source (jamais déduit d'un résumé profil).
// score_* = score FINAL du match (rounds gagnés, ex. 2-1), pas les points par
// round. winner_athlete_id vient du marqueur de vainqueur exposé par la source,
// jamais de score_a > score_b (RSC/DSQ/WDR...). bracket_stage = tour du
// tableau (F, SF, QF, R16...) — à ne pas confondre avec les rounds R1/R2/R3
// d'un combat, non modélisés en V1. Contraintes CHECK (a <> b, winner ∈ {a,b})
// ajoutées à la main dans la migration (non exprimables en Prisma).
model competition_match {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  competition_id String      @db.Uuid
  competition    competition @relation(fields: [competition_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  source             String  @db.VarChar(50)
  source_external_id String  @db.VarChar(255)
  source_url         String? @db.VarChar(500)

  occurred_at    DateTime? @db.Timestamp(6)
  category_label String?   @db.VarChar(100)
  bracket_stage  String?   @db.VarChar(50)
  contest_number Int?

  athlete_a_id String           @db.Uuid
  athlete_b_id String           @db.Uuid
  athlete_a    external_athlete @relation("match_athlete_a", fields: [athlete_a_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  athlete_b    external_athlete @relation("match_athlete_b", fields: [athlete_b_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  score_a Int?
  score_b Int?

  winner_athlete_id String?           @db.Uuid
  winner            external_athlete? @relation("match_winner", fields: [winner_athlete_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  result_method     String? @db.VarChar(20)
  result_method_raw String? @db.VarChar(100)

  created_at DateTime? @default(now()) @db.Timestamp(6)
  updated_at DateTime? @default(now()) @db.Timestamp(6)

  // TOUTES les représentations source du combat (voir competition_match_source).
  sources competition_match_source[]

  @@unique([source, source_external_id])
  @@index([competition_id])
  @@index([athlete_a_id])
  @@index([athlete_b_id])
}

// Une ligne par REPRÉSENTATION SOURCE d'un combat logique. WT Results publie
// parfois le même combat réel sous plusieurs identifiants de match (constat :
// Muju, 4 pages /results/<uuid> strictement identiques par combat) : ils sont
// tous conservés ici comme provenance, rattachés à UN seul competition_match.
// competition_match.source/source_external_id restent la représentation
// retenue à la création (comportement historique inchangé) ; ce tableau contient
// aussi celle-là, il est donc l'inventaire COMPLET des identifiants connus.
//
// Volontairement AUCUN UNIQUE en base sur la clé logique du combat
// (competition_id, category_label, contest_number, paire non ordonnée) : la
// stratégie exige de pouvoir CONSERVER un cas conflictuel/ambigu (deux
// représentations qui partagent cette clé avec des attributs incompatibles)
// plutôt que de fusionner de force. La clé sert de clé de rapprochement
// conservatrice dans l'importer, avec détection explicite des conflits.
model competition_match_source {
  id                   String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  competition_match_id String            @db.Uuid
  competition_match    competition_match @relation(fields: [competition_match_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  source             String  @db.VarChar(50)
  source_external_id String  @db.VarChar(255)
  source_url         String? @db.VarChar(500)

  created_at DateTime? @default(now()) @db.Timestamp(6)

  @@unique([source, source_external_id])
  @@index([competition_match_id])
}

model exercise {
  id                          String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  titre                       String                        @db.VarChar(255)
  type_exercice               String?                       @db.VarChar(50)
  panel_technique             String?                       @db.VarChar(100)
  niveau                      String?                       @db.VarChar(50)
  description                 String?
  video_url                   String?
  gratuit                     Boolean?                      @default(true)
  // Nullable, additif : NULL = exercice système/global (comportement
  // historique inchangé — c'est la valeur de TOUTES les lignes existantes
  // avant ce ticket, jamais réécrite). Non-null = exercice créé par un
  // coach, visible uniquement par les athlètes assignés (voir
  // coach_exercise_assignment) — jamais par simple présence dans le
  // catalogue. `gratuit` reste un champ dormant, sans lien avec cette
  // colonne : aucune preuve qu'il gouverne une quelconque visibilité
  // aujourd'hui (voir rapport d'audit), donc pas réutilisé ici.
  created_by_coach_id         String?                       @db.Uuid
  created_at                  DateTime?                     @default(now()) @db.Timestamp(6)
  updated_at                  DateTime?                     @default(now()) @db.Timestamp(6)
  coach_profile               coach_profile?                @relation(fields: [created_by_coach_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  coach_exercise_assignment   coach_exercise_assignment[]
  coach_exercise_group_source coach_exercise_group_source[]

  @@index([created_by_coach_id])
}

// Publication d'un exercice coach vers UN athlète (visibilité, pas
// propriété — voir exercise.created_by_coach_id pour la propriété). SNAPSHOT
// au moment de la publication (ticket §12), même philosophie que
// coach_training_assignment : un groupe modifié après coup ne change jamais
// rétroactivement les publications déjà faites, seul un nouveau PUT
// .../assignments recalcule.
model coach_exercise_assignment {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  exercise_id String    @db.Uuid
  athlete_id  String    @db.Uuid
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  exercise    exercise  @relation(fields: [exercise_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  athlete     athlete   @relation(fields: [athlete_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([exercise_id, athlete_id])
  @@index([athlete_id])
}

// Provenance "cet exercice a été publié (aussi) via ce groupe" — même rôle
// que coach_training_group_source : reconstitue l'affichage "Publié à : ...",
// jamais utilisée comme preuve d'autorisation. Cascade sur suppression du
// groupe : la provenance disparaît, les assignments déjà publiées restent
// (ticket §18).
model coach_exercise_group_source {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  exercise_id String      @db.Uuid
  group_id    String      @db.Uuid
  created_at  DateTime?   @default(now()) @db.Timestamp(6)
  exercise    exercise    @relation(fields: [exercise_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  coach_group coach_group @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([exercise_id, group_id])
}

model goal_step {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  goal_id      String       @db.Uuid
  titre        String       @db.VarChar(255)
  ordre        Int?         @default(0)
  completed    Boolean?     @default(false)
  completed_at DateTime?    @db.Timestamp(6)
  created_at   DateTime?    @default(now()) @db.Timestamp(6)
  athlete_goal athlete_goal @relation(fields: [goal_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model metric_measurement {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  athlete_id     String      @db.Uuid
  metric_type_id String      @db.Uuid
  valeur         Decimal     @db.Decimal(10, 2)
  mesure_le      DateTime    @default(now()) @db.Timestamp(6)
  coach_user_id  String?     @db.Uuid
  commentaire    String?
  created_at     DateTime?   @default(now()) @db.Timestamp(6)
  athlete        athlete     @relation(fields: [athlete_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  app_user       app_user?   @relation(fields: [coach_user_id], references: [id], onUpdate: NoAction)
  metric_type    metric_type @relation(fields: [metric_type_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([athlete_id, mesure_le(sort: Desc)], map: "idx_metric_measurement_athlete_date")
}

model metric_type {
  id                    String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                  String               @unique @db.VarChar(100)
  nom                   String               @db.VarChar(255)
  unite                 String?              @db.VarChar(50)
  description           String?
  improvement_direction String?              @db.VarChar(10)
  // Barème de l'étoile de compétences : valeur mesurée qui vaut 0/100 et
  // celle qui vaut 100/100 (pour une capacité "lower", score_zero est la
  // plus GRANDE valeur, ex. temps de réaction 600 ms -> 0, 250 ms -> 100).
  // Null = capacité absente de l'étoile (jamais une note inventée).
  score_zero            Decimal?             @db.Decimal(10, 2)
  score_hundred         Decimal?             @db.Decimal(10, 2)
  created_at            DateTime?            @default(now()) @db.Timestamp(6)
  metric_measurement    metric_measurement[]
  club_scales           club_metric_scale[]
}

// Barème de l'étoile de compétences décidé par les coachs d'un CLUB pour une
// capacité : remplace, pour les athlètes de ce club (athlete.club_id), le
// barème par défaut de metric_type (score_zero/score_hundred). Une seule
// ligne par (club, capacité) ; supprimer la ligne = revenir au défaut.
// Même sens que le défaut : pour une capacité "lower", score_zero > score_hundred.
model club_metric_scale {
  id                 String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  club_id            String      @db.Uuid
  metric_type_id     String      @db.Uuid
  score_zero         Decimal     @db.Decimal(10, 2)
  score_hundred      Decimal     @db.Decimal(10, 2)
  updated_by_user_id String?     @db.Uuid
  updated_at         DateTime    @default(now()) @db.Timestamp(6)
  club               club        @relation(fields: [club_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  metric_type        metric_type @relation(fields: [metric_type_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  updated_by         app_user?   @relation("club_scale_editor", fields: [updated_by_user_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([club_id, metric_type_id])
}

model participation {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  athlete_id      String      @db.Uuid
  competition_id  String      @db.Uuid
  categorie_poids String?     @db.VarChar(50)
  categorie_age   String?     @db.VarChar(50)
  statut          String?     @default("inscrit") @db.VarChar(50)
  classement      Int?
  medaille        String?     @db.VarChar(30)
  victoires       Int?        @default(0)
  defaites        Int?        @default(0)
  points_gagnes   Int?        @default(0)
  created_at      DateTime?   @default(now()) @db.Timestamp(6)
  updated_at      DateTime?   @default(now()) @db.Timestamp(6)
  athlete         athlete     @relation(fields: [athlete_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  competition     competition @relation(fields: [competition_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([athlete_id, competition_id])
  @@index([athlete_id], map: "idx_participation_athlete")
  @@index([competition_id], map: "idx_participation_competition")
}

model training_session {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  athlete_id  String    @db.Uuid
  titre       String    @db.VarChar(255)
  type_seance String?   @db.VarChar(50)
  sous_type   String?   @db.VarChar(100)
  date_debut  DateTime  @db.Timestamp(6)
  date_fin    DateTime? @db.Timestamp(6)
  lieu        String?   @db.VarChar(255)
  niveau      String?   @db.VarChar(50)
  description String?
  statut      String?   @default("prevu") @db.VarChar(30)
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  updated_at  DateTime? @default(now()) @db.Timestamp(6)
  athlete     athlete   @relation(fields: [athlete_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  // Optionnel : présent uniquement si cette ligne a été GÉNÉRÉE par une
  // séance collective coach (voir coach_training_session). Une ligne créée
  // par l'athlète lui-même via POST /athletes/:id/trainings n'a pas de
  // coach_training_assignment — training_session reste par ailleurs
  // strictement inchangé (voir ticket "Entraînements collectifs Coach").
  coach_training_assignment coach_training_assignment?
  training_attendance       training_attendance[]

  @@index([athlete_id, date_debut], map: "idx_training_session_athlete_date")
}

model weight_log {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  athlete_id  String    @db.Uuid
  valeur_kg   Decimal   @db.Decimal(5, 2)
  date_mesure DateTime  @default(now()) @db.Timestamp(6)
  note        String?
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  athlete     athlete   @relation(fields: [athlete_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([athlete_id, date_mesure(sort: Desc)], map: "idx_weight_log_athlete_date")
}

model weight_target {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  athlete_id     String       @db.Uuid
  competition_id String?      @db.Uuid
  poids_cible_kg Decimal      @db.Decimal(5, 2)
  date_cible     DateTime?    @db.Date
  actif          Boolean?     @default(true)
  created_at     DateTime?    @default(now()) @db.Timestamp(6)
  updated_at     DateTime?    @default(now()) @db.Timestamp(6)
  athlete        athlete      @relation(fields: [athlete_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  competition    competition? @relation(fields: [competition_id], references: [id], onUpdate: NoAction)
}

// Profil coach d'un app_user (miroir d'`athlete` : identité — nom, prénom,
// email — reste exclusivement sur app_user, jamais dupliquée ici). Relation
// 1:1 stricte via user_id unique, comme athlete.user_id. Un app_user peut
// posséder à la fois athlete et coach_profile (utilisateur hybride) : ce
// sont deux profils indépendants sur la même identité, pas un rôle exclusif.
model coach_profile {
  id                            String                          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                       String                          @unique @db.Uuid
  club_id                       String?                         @db.Uuid
  created_at                    DateTime?                       @default(now()) @db.Timestamp(6)
  updated_at                    DateTime?                       @default(now()) @db.Timestamp(6)
  app_user                      app_user                        @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  club                          club?                           @relation(fields: [club_id], references: [id], onUpdate: NoAction)
  athletes                      coach_athlete[]
  groups                        coach_group[]
  coach_training_session        coach_training_session[]
  exercises                     exercise[]
  coach_competition_preparation coach_competition_preparation[]
  club_invitation               club_invitation[]
}

// Sélection/préparation interne du coach pour une compétition — distincte
// d'une participation officielle FFTDA/WT/Martial Events (voir
// CoachCompetitionPreparationsService pour la justification complète du
// choix d'une ressource séparée plutôt que d'enrichir `participation`) :
// un coach peut préparer un athlète AVANT toute inscription fédérale connue,
// et deux coachs liés au même athlète ont chacun leur propre préparation
// privée — jamais partagée, jamais visible de l'autre coach (voir
// CoachPreparationOwnershipGuard). `statut` reste une convention interne en
// varchar (jamais un enum Prisma), même politique que `participation.statut`.
model coach_competition_preparation {
  id                     String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  coach_id               String        @db.Uuid
  athlete_id             String        @db.Uuid
  competition_id         String        @db.Uuid
  statut                 String        @default("envisage") @db.VarChar(20)
  categorie_age_prevue   String?       @db.VarChar(50)
  categorie_poids_prevue String?       @db.VarChar(50)
  objectif               String?
  note_coach             String?
  created_at             DateTime?     @default(now()) @db.Timestamp(6)
  updated_at             DateTime?     @default(now()) @db.Timestamp(6)
  coach_profile          coach_profile @relation(fields: [coach_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  athlete                athlete       @relation(fields: [athlete_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  competition            competition   @relation(fields: [competition_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([coach_id, athlete_id, competition_id])
  @@index([athlete_id])
  @@index([competition_id])
}

// Source de vérité UNIQUE de l'autorisation coach -> athlète (voir
// CoachAthleteAccessGuard). Jamais club_id, jamais coach_group : un athlète
// dans un groupe d'un coach doit toujours avoir une ligne coach_athlete
// correspondante (contrôlé côté service à l'ajout en groupe, pas par une
// contrainte DB — voir coach_group_athlete).
model coach_athlete {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  coach_id      String        @db.Uuid
  athlete_id    String        @db.Uuid
  created_at    DateTime?     @default(now()) @db.Timestamp(6)
  coach_profile coach_profile @relation(fields: [coach_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  athlete       athlete       @relation(fields: [athlete_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([coach_id, athlete_id])
  @@index([athlete_id])
}

// Groupe métier créé par un coach (ex. "Élite", "Juniors"). Unicité du nom
// scoped par coach (deux coachs différents peuvent avoir chacun un groupe
// "Élite"). Comparaison case-sensitive (comportement par défaut de l'index
// unique Postgres sur VARCHAR) : aucune normalisation le -> pas de politique
// de casse implicite non documentée pour ce MVP.
model coach_group {
  id                          String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  coach_id                    String                        @db.Uuid
  name                        String                        @db.VarChar(255)
  created_at                  DateTime?                     @default(now()) @db.Timestamp(6)
  updated_at                  DateTime?                     @default(now()) @db.Timestamp(6)
  coach_profile               coach_profile                 @relation(fields: [coach_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  members                     coach_group_athlete[]
  coach_training_group_source coach_training_group_source[]
  coach_exercise_group_source coach_exercise_group_source[]
  coach_training_assignment   coach_training_assignment[]
  club_invitation             club_invitation[]

  @@unique([coach_id, name])
}

// Membership d'un athlète dans un coach_group. La DB seule ne peut pas
// garantir que l'athlète appartient déjà à coach_athlete pour le coach
// propriétaire du groupe (ce sont deux tables sans FK composite croisée
// possible en Postgres/Prisma) : cette règle est vérifiée par
// CoachGroupsService avant tout insert ici (voir §25/§26 du ticket).
model coach_group_athlete {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  group_id    String      @db.Uuid
  athlete_id  String      @db.Uuid
  created_at  DateTime?   @default(now()) @db.Timestamp(6)
  coach_group coach_group @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  athlete     athlete     @relation(fields: [athlete_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([group_id, athlete_id])
  @@index([athlete_id])
}

// Séance collective créée par un coach : la définition CONCEPTUELLE d'une
// séance ("Combat — Groupe Élite — vendredi 20h"). N'est jamais lue
// directement par le frontend athlète — training_session (inchangé) reste
// l'unique source consommée par athletes/:id/trainings. Une modification de
// ce modèle est PROPAGÉE explicitement (transaction) vers chaque
// training_session généré, via coach_training_assignment. Mêmes noms de
// champs que training_session (titre/date_debut/...) : la propagation est
// une copie champ à champ triviale à auditer, jamais une transformation.
model coach_training_session {
  id            String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  coach_id      String                        @db.Uuid
  titre         String                        @db.VarChar(255)
  type_seance   String?                       @db.VarChar(50)
  sous_type     String?                       @db.VarChar(100)
  date_debut    DateTime                      @db.Timestamp(6)
  date_fin      DateTime?                     @db.Timestamp(6)
  lieu          String?                       @db.VarChar(255)
  niveau        String?                       @db.VarChar(50)
  description   String?
  statut        String?                       @default("prevu") @db.VarChar(30)
  // Séance récurrente : même valeur pour toutes les occurrences générées
  // ensemble (POST /coach/trainings/series), null pour une séance isolée.
  // Pas de table "série" : chaque occurrence reste une séance complète et
  // autonome (présences, modification, annulation inchangées) — series_id
  // sert uniquement à les retrouver ensemble (annuler la suite).
  series_id     String?                       @db.Uuid
  created_at    DateTime?                     @default(now()) @db.Timestamp(6)
  updated_at    DateTime?                     @default(now()) @db.Timestamp(6)
  coach_profile coach_profile                 @relation(fields: [coach_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  assignments   coach_training_assignment[]
  group_sources coach_training_group_source[]

  @@index([coach_id, date_debut])
  @@index([coach_id, series_id])
}

// Lien entre une séance collective et CHAQUE training_session réellement
// généré (une ligne training_session par athlète assigné — le modèle
// athlete-facing reste 1 ligne = 1 athlète, inchangé). training_session_id
// est unique : un training_session donné appartient au plus à UNE séance
// collective. Source de vérité de "qui reçoit réellement" la séance —
// jamais coach_training_group_source, qui n'est qu'une provenance.
//
// group_id (ticket Présences Coach V1 §6/§19) : SNAPSHOT du groupe ayant
// réellement produit cet athlète au moment de la résolution des
// destinataires (null si assignation individuelle) — sert uniquement à
// afficher un libellé de groupe par athlète sur la feuille de présence,
// jamais une autorisation ni une source de vérité de membership (celle-ci
// reste coach_group_athlete, qui peut dériver ensuite sans réécrire cette
// ligne). Si l'athlète est atteignable via plusieurs groupes à la
// résolution, un seul est retenu arbitrairement (premier trouvé) : c'est un
// libellé, pas une preuve. onDelete: SetNull (jamais Cascade/Restrict) :
// supprimer un groupe ne doit jamais faire disparaître ou bloquer un
// assignment/attendance historique, seul le libellé redevient "Individuel".
model coach_training_assignment {
  id                        String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  coach_training_session_id String                 @db.Uuid
  training_session_id       String                 @unique @db.Uuid
  athlete_id                String                 @db.Uuid
  group_id                  String?                @db.Uuid
  created_at                DateTime?              @default(now()) @db.Timestamp(6)
  coach_training_session    coach_training_session @relation(fields: [coach_training_session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  training_session          training_session       @relation(fields: [training_session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  athlete                   athlete                @relation(fields: [athlete_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  coach_group               coach_group?           @relation(fields: [group_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([coach_training_session_id, athlete_id])
  @@index([athlete_id])
}

// Provenance "cette séance a été assignée (aussi) via ce groupe", utilisée
// uniquement pour reconstituer `assignments.groups` côté lecture et pour
// recalculer le snapshot lors d'un remplacement complet des destinataires
// (PUT .../assignments). Ne remplace jamais coach_training_assignment comme
// preuve d'autorisation : SNAPSHOT au moment de l'assignation (voir ticket
// §5) — si le groupe change de composition ensuite, ces lignes ne sont pas
// réécrites automatiquement. Cascade sur suppression du groupe : la
// provenance disparaît, la séance et les assignments restent (ticket §21).
model coach_training_group_source {
  id                        String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  coach_training_session_id String                 @db.Uuid
  group_id                  String                 @db.Uuid
  created_at                DateTime?              @default(now()) @db.Timestamp(6)
  coach_training_session    coach_training_session @relation(fields: [coach_training_session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  coach_group               coach_group            @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([coach_training_session_id, group_id])
}

// Présence d'un athlète à une séance (ticket "Présences Coach V1"). FK sur
// training_session_id (jamais coach_training_session_id) : c'est la ligne
// athlete-facing qui porte l'état réel (date/statut/annulation) lu par
// CoachTrainingsRepository, et coach_training_assignment.training_session_id
// est déjà @unique — un training_session donné a au plus une assignation,
// donc au plus une présence. athlete_id est en principe déductible de
// training_session.athlete_id mais reste explicite ici (même politique que
// participation/coach_competition_preparation : jamais un id implicite
// seul pour une contrainte unique métier) et sert de garde-fou défensif
// côté service (l'athleteId envoyé doit correspondre à l'athlète réel de la
// session, jamais uniquement au training_session_id).
//
// Pas de recorded_by_coach_id (décision explicite, ticket §3) : l'unique
// coach autorisé à écrire ici est déjà garanti par CoachTrainingOwnershipGuard
// avant que la mutation n'atteigne le service — dupliquer un id de
// propriétaire déjà impliqué par la chaîne de FK (training_session ->
// coach_training_session -> coach) irait à l'encontre de la convention déjà
// établie par coach_competition_preparation (note_coach n'a pas non plus de
// tel champ).
//
// status reste une convention interne en varchar non accentué (jamais un
// enum Prisma), même politique que tous les statuts de ce projet
// (participation.statut, coach_competition_preparation.statut, ...) :
// "present" | "absent" | "excuse". Pas de "retard" en V1 (décision
// explicite, évaluée puis écartée pendant l'audit — voir rapport).
// Notification in-app persistante (ticket "Notifications in-app Coach +
// Athlete V1"). Appartient à un app_user (recipient_user_id), jamais
// directement à athlete_id/coach_id : un même app_user peut posséder à la
// fois athlete et coach_profile (utilisateur hybride, voir JwtPayload) —
// recipient_user_id reste l'identité stable quel que soit le rôle actif au
// moment de la lecture. `context` (ATHLETE|COACH) distingue l'interface pour
// laquelle cette notification a du sens, pour qu'un compte hybride ne voie
// jamais dans CoachFrontend une notification rédigée pour l'athlète (et
// inversement) — convention varchar contrôlée en application, jamais un enum
// Prisma (même politique que tous les statuts de ce projet : participation,
// coach_competition_preparation, training_attendance...).
// title/message sont un SNAPSHOT au moment de la création : si la ressource
// source change ensuite (renommée) ou disparaît, l'historique de
// notification reste compréhensible tel quel, jamais recalculé à la lecture.
// resource_type/resource_id servent UNIQUEMENT au deep-link frontend — ne
// remplacent jamais l'autorisation backend (la route de la ressource
// continue de vérifier l'accès normalement à l'ouverture, voir
// NotificationsService).
model notification {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipient_user_id String    @db.Uuid
  actor_user_id     String?   @db.Uuid
  context           String    @db.VarChar(10)
  type              String    @db.VarChar(40)
  title             String    @db.VarChar(255)
  message           String?
  resource_type     String?   @db.VarChar(30)
  resource_id       String?   @db.Uuid
  is_read           Boolean   @default(false)
  created_at        DateTime  @default(now()) @db.Timestamp(6)
  read_at           DateTime? @db.Timestamp(6)
  recipient         app_user  @relation("notification_recipient", fields: [recipient_user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  actor             app_user? @relation("notification_actor", fields: [actor_user_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([recipient_user_id, created_at(sort: Desc)], map: "idx_notification_recipient_created")
  @@index([recipient_user_id, is_read], map: "idx_notification_recipient_unread")
}

model training_attendance {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  training_session_id String           @db.Uuid
  athlete_id          String           @db.Uuid
  status              String           @db.VarChar(20)
  note                String?
  created_at          DateTime?        @default(now()) @db.Timestamp(6)
  updated_at          DateTime?        @default(now()) @db.Timestamp(6)
  training_session    training_session @relation(fields: [training_session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  athlete             athlete          @relation(fields: [athlete_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([training_session_id, athlete_id])
  @@index([athlete_id])
}

// Invitation permettant à un athlète de créer son compte en rejoignant un
// club (Ticket "Clubs, invitations & inscription Athlete contrôlée V1").
// Le code brut n'est JAMAIS stocké : code_hash est un hash cryptographique du
// code normalisé (uppercase, séparateurs retirés) — voir InvitationsService.
// used_at/revoked_at sont indépendants (une invitation non utilisée peut être
// révoquée ; une invitation déjà utilisée n'est jamais "dé-révocable" via ce
// champ) : la validité exige les deux null ET expires_at dans le futur (voir
// InvitationsRepository.consumeIfUsable pour la garantie d'usage unique sous
// concurrence). assigned_group_id est optionnel : un athlète peut rejoindre
// le club sans groupe (onDelete: SetNull, jamais Cascade — la suppression
// d'un groupe ne doit jamais invalider une invitation déjà émise, seule
// l'affectation de groupe automatique à l'inscription disparaît).
model club_invitation {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  club_id             String        @db.Uuid
  created_by_coach_id String        @db.Uuid
  code_hash           String        @unique @db.VarChar(255)
  assigned_group_id   String?       @db.Uuid
  expires_at          DateTime      @db.Timestamp(6)
  used_at             DateTime?     @db.Timestamp(6)
  revoked_at          DateTime?     @db.Timestamp(6)
  created_at          DateTime?     @default(now()) @db.Timestamp(6)
  club                club          @relation(fields: [club_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  created_by_coach    coach_profile @relation(fields: [created_by_coach_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  assigned_group      coach_group?  @relation(fields: [assigned_group_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([club_id])
  @@index([created_by_coach_id])
}

// ---------------------------------------------------------------------------
// Ticket #12E — moteur d'orchestration du backfill WT Results (discovery,
// queue persistée, reprise après crash). N'IMPORTE RIEN lui-même : ORCHESTRE
// le pipeline existant (WtResultsImportService.runPilot, wtr-competition-
// matcher). Voir src/international/wt-backfill/.
//
// Un run représente une demande bornée et immuable après discovery : la
// discovery fige une fois pour toutes la liste + l'ordre des événements
// (wt_backfill_event.sequence). Une nouvelle discovery = un nouveau run.
// ---------------------------------------------------------------------------

// Statuts (voir wt-backfill-state.ts, seule source de vérité des transitions
// autorisées) : PENDING -> RUNNING -> COMPLETED | BLOCKED | FAILED.
// Pas de CANCELLED : aucune commande #12E ne l'utilise (annulation = laisser
// le run BLOCKED/FAILED en l'état, resumable plus tard).
model wt_backfill_run {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  status                 String    @db.VarChar(20)
  // Scope figé à la création : {"kind":"year","year":2026} ou
  // {"kind":"range","from":"...","to":"..."} ou {"kind":"slugs","slugs":[...]}.
  requested_scope        Json
  discovered_event_count Int       @default(0)
  completed_event_count  Int       @default(0)
  blocked_event_count    Int       @default(0)
  failed_event_count     Int       @default(0)
  notes                  String?
  created_at             DateTime  @default(now()) @db.Timestamp(6)
  started_at             DateTime? @db.Timestamp(6)
  finished_at            DateTime? @db.Timestamp(6)

  events wt_backfill_event[]

  @@index([status])
}

// Un événement Results borné (identité externe = slug, déjà la clé stable
// utilisée par tout le pipeline existant). mapping_verdict/competition_id
// sont calculés une fois à la discovery (canonical matcher, jamais réélargi
// ici) : SAFE -> PENDING, AMBIGUOUS/UNMATCHED -> BLOCKED immédiatement, sans
// jamais être traité.
model wt_backfill_event {
  id                     String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  run_id                 String       @db.Uuid
  run                    wt_backfill_run @relation(fields: [run_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sequence               Int
  slug                   String       @db.VarChar(255)
  event_name             String?      @db.VarChar(255)
  event_date_start       DateTime?    @db.Date
  event_date_end         DateTime?    @db.Date
  mapping_verdict        String       @db.VarChar(20)
  competition_id         String?      @db.Uuid
  competition            competition? @relation(fields: [competition_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  status                 String       @db.VarChar(20)
  attempt_count          Int          @default(0)
  started_at             DateTime?    @db.Timestamp(6)
  finished_at            DateTime?    @db.Timestamp(6)
  last_error             String?
  // Reprise "au mieux" intra-événement : dernière catégorie terminée. Le
  // pipeline runPilot reste la source d'idempotence réelle (par match) ; ce
  // champ évite seulement de refaire les catégories déjà propres.
  last_completed_category String?     @db.VarChar(100)
  // Agrégat du PilotImportReport (catégories traitées, combats créés/
  // attachés/rafraîchis, athlètes créés/réutilisés, conflicts, ambiguous,
  // parse failures, pages, durée).
  stats                  Json?
  created_at             DateTime     @default(now()) @db.Timestamp(6)

  @@unique([run_id, slug])
  @@index([run_id, sequence])
  @@index([status])
}

PORT=3000

# URL de connexion PostgreSQL (voir prisma.config.ts)
DATABASE_URL="postgresql://user:password@localhost:5432/db"

# Secret de signature JWT. Obligatoire : le serveur refuse de démarrer si
# absent. Générer une valeur aléatoire longue, par exemple :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""

# Durée de vie du token (et du cookie d'auth), au format accepté par
# @nestjs/jwt (ex. "7d", "24h").
JWT_EXPIRES_IN="7d"

# --- Production (voir deploy/README.md) -----------------------------------
# NODE_ENV=production active les cookies Secure et rend CORS_ORIGINS obligatoire.
# NODE_ENV=production

# Origines des deux frontends, séparées par des virgules (sans / final).
# Dev : inutile (localhost:5173 et localhost:5174 par défaut).
# CORS_ORIGINS="https://app.example.fr,https://coach.example.fr"

# API derrière un reverse proxy local (Caddy + Cloudflare Tunnel) : "loopback".
# TRUST_PROXY=loopback

# Dev uniquement : rouvre POST /competitions/import/* (fermées par défaut).
# En production, utiliser : npm run import:competitions -- fftda
# ALLOW_HTTP_IMPORTS=true
